{
  "name": "custos_api",
  "main": "src/index.ts",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "custos_db",
      "database_id": "f19743bd-3f9e-4adf-a61a-8eb3bf7c35e9"
    }
  ],

  "env": {
    "production": {
      "vars": {
        "CORS_ORIGIN": "https://silvaweb.org"
      }
    },
    "development": {
      "vars": {
        "CORS_ORIGIN": "*"
      }
    }
  },

  "build": {
    "command": "echo 'No build step required'"
  }
}
